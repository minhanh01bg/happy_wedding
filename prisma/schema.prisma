generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CustomerAccount {
  id              String    @id @default(cuid())
  phoneNormalized String    @unique
  displayName     String
  passwordHash    String
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  disabledAt      DateTime?

  sessions      CustomerSession[]
  invitations   Invitation[]
  serviceOrders ServiceOrder[]
}

model CustomerSession {
  id         String          @id @default(cuid())
  accountId  String
  account    CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash  String          @unique
  expiresAt  DateTime
  createdAt  DateTime        @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?

  @@index([accountId, expiresAt])
  @@index([expiresAt])
}

model AdminIdentity {
  id           String    @id @default(cuid())
  username     String    @unique
  role         String    @default("owner") /// owner | manager | staff
  passwordHash String?
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  disabledAt   DateTime?

  sessions    AdminSession[]
  auditEvents AdminAuditEvent[]

  @@index([disabledAt])
}

model AdminSession {
  id              String        @id @default(cuid())
  identityId      String
  identity        AdminIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  tokenHash       String        @unique
  identityVersion Int           @default(1)
  expiresAt       DateTime
  idleExpiresAt   DateTime
  lastSeenAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  revokedAt       DateTime?

  @@index([identityId, expiresAt])
  @@index([tokenHash, revokedAt])
  @@index([expiresAt])
}

model AdminAuditEvent {
  id         String         @id @default(cuid())
  identityId String?
  identity   AdminIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   String?
  ipAddress  String?
  createdAt  DateTime       @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([identityId, createdAt])
}

model Setting {
  key   String @id
  value String
}

model WeddingTemplate {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  category    String
  description String
  palette     String       @default("rose")
  layout      String       @default("editorial")
  premium     Boolean      @default(false)
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ServicePlan {
  id               String         @id @default(cuid())
  name             String
  description      String
  price            Int
  months           Int            @default(12)
  maxPhotos        Int            @default(12)
  premiumTemplates Boolean        @default(false)
  removeBranding   Boolean        @default(false)
  active           Boolean        @default(true)
  sortOrder        Int            @default(0)
  orders           ServiceOrder[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Invitation {
  id           String          @id @default(cuid())
  ownerId      String
  owner        CustomerAccount @relation(fields: [ownerId], references: [id])
  templateId   String
  template     WeddingTemplate @relation(fields: [templateId], references: [id])
  slug         String          @unique
  groom        String
  bride        String
  weddingDate  DateTime
  headline     String          @default("Một đời thương, một đời bên nhau.")
  story        String          @default("")
  groomParents String          @default("")
  brideParents String          @default("")
  eventsJson   String          @default("[]")
  photosJson   String          @default("[]")
  coverUrl     String          @default("/images/couple.jpg")
  musicUrl     String          @default("")
  giftBank     String          @default("")
  giftAccount  String          @default("")
  giftName     String          @default("")
  brideGiftBank String @default("")
  brideGiftAccount String @default("")
  brideGiftName String @default("")
  status       String          @default("draft")
  isDemo       Boolean         @default(false)
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  orders       ServiceOrder[]
  responses    GuestResponse[]
  guests       WeddingGuest[]

  @@index([ownerId, createdAt])
  @@index([status, weddingDate])
}

model ServiceOrder {
  id               String           @id @default(cuid())
  code             String           @unique
  clientId         String           @unique
  accountId        String
  account          CustomerAccount  @relation(fields: [accountId], references: [id])
  invitationId     String
  invitation       Invitation       @relation(fields: [invitationId], references: [id])
  planId           String
  plan             ServicePlan      @relation(fields: [planId], references: [id])
  planName         String
  total            Int
  months           Int
  maxPhotos        Int
  premiumTemplates Boolean
  removeBranding   Boolean
  status           String           @default("pending")
  paymentNote      String           @default("")
  paidAt           DateTime?
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  payments         WeddingPayment[]

  @@index([accountId, createdAt])
  @@index([invitationId, status, expiresAt])
  @@index([status, createdAt])
}

model WeddingPayment {
  id            String       @id @default(cuid())
  orderId       String
  order         ServiceOrder @relation(fields: [orderId], references: [id])
  provider      String
  transactionId String       @unique
  amount        Int
  receivedAt    DateTime     @default(now())
}

model WeddingGuest {
  id           String          @id @default(cuid())
  invitationId String
  invitation   Invitation      @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  name         String
  group        String          @default("Bạn bè")
  token        String          @unique
  createdAt    DateTime        @default(now())
  responses    GuestResponse[]

  @@index([invitationId, createdAt])
}

model GuestResponse {
  id           String        @id @default(cuid())
  invitationId String
  invitation   Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestId      String?
  guest        WeddingGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  clientId     String
  name         String
  attendance   String
  partySize    Int           @default(1)
  eventIndex   Int           @default(0)
  message      String        @default("")
  wishStatus   String        @default("pending")
  createdAt    DateTime      @default(now())

  @@unique([invitationId, clientId])
  @@index([invitationId, createdAt])
  @@index([invitationId, wishStatus])
}
