DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_NAME="Hỷ Studio"
NEXT_PUBLIC_APP_URL="http://localhost:3200"
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Generated via pnpm setup; salt:PBKDF2 hash, never a plain password.
STORE_PASSWORD_HASH=""
CSP_MODE="report-only"
# Required in production (preserved safeguards from my_task).
CANONICAL_ORIGIN=""
# `next dev` only: extra hostnames allowed to load dev assets, comma-separated,
# no scheme/port (wildcards like *.example.com allowed). 127.0.0.1 and the
# public IP are always allowed. Example: "thiep.example.com"
ALLOWED_DEV_ORIGINS=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Production rate-limit store: Upstash (above) unless this is "memory", which
# keeps counters inside the server process and is valid for ONE instance only
# (docs/adr/0012). Never a default; dev and tests always use memory. Our
# single-host site sets it in .env.production.local and leaves UPSTASH_* out.
# RATE_LIMIT_STORE="memory"
RATE_LIMIT_KEY_SECRET=""
# "none" suits local dev only; production refuses it. Behind our nginx, which
# overwrites X-Real-IP with the client address (app on 127.0.0.1), set in
# .env.production.local: TRUSTED_PROXY_MODE="custom" and
# TRUSTED_CLIENT_IP_HEADER="x-real-ip". See docs/OPERATIONS.md, "Production".
TRUSTED_PROXY_MODE="none"
# Optional SePay automatic payment; API Key auth, incoming transfers only.
SEPAY_WEBHOOK_API_KEY=""
SEPAY_ACCOUNT_NUMBER=""
